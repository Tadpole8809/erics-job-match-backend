# Copy this file to .env and fill in your keys. Never commit .env.

# Job APIs: you need at least one. With both set, JSearch is used by default.
# SerpApi (Google Jobs): https://serpapi.com/manage-api-key
SERPAPI_KEY=
# JSearch on RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_KEY=

# Gemini, for match scoring and reading the resume: https://aistudio.google.com/apikey
# Without it, /match falls back to a rough keyword score and resume reading is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Passcode for the app. Set this before the server can be reached from outside your
# own computer; the phone asks for it once and remembers it. Use something long.
# Leave empty for no passcode (only OK on your own computer).
APP_PASSCODE=

# SQLite database file (created automatically)
DB_PATH=jobmatch.db

# Frontend origins allowed to call the API, comma-separated. * = allow all (fine for local dev).
CORS_ORIGINS=*
